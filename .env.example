# ============================================================================
#  TDR AI Discord bot – configuration
#  Copy to .env (or run ./setup.sh) and fill in the two Discord values.
# ============================================================================

# --- Discord (required) -----------------------------------------------------
DISCORD_BOT_TOKEN=paste-your-bot-token-here
DISCORD_USER_ID=123456789012345678
# Optional: channel used when DMs fail (right-click channel > Copy Channel ID)
DISCORD_ALERT_CHANNEL_ID=
# Optional: extra user IDs allowed to press buttons / use commands (comma separated)
EXTRA_ALLOWED_USER_IDS=

# --- Model ------------------------------------------------------------------
# Relative paths are resolved from this folder. If missing, the bot tries:
# model_errors_cambridge_definitiu.tflite, model_errors_cambridge.tflite,
# model_errors_3d.tflite, printer_failure_detector.tflite (here and in ../)
MODEL_PATH=printWatcher_efficientnet_v2s.tflite
# 2 threads leaves 2 Cortex-A72 cores for Klipper / Moonraker / Crowsnest
TFLITE_THREADS=2

# --- Detection --------------------------------------------------------------
AI_ENABLED=true
# supervised = DM me with buttons first | autonomous = act immediately
AI_MODE=supervised
CONFIDENCE_THRESHOLD=0.60
CONSECUTIVE_FRAMES=4
# Seconds between frames while printing (4/6 sliding window x 2.5 s ≈ 10 s to confirm)
CHECK_INTERVAL=2.5
# Supervised mode: auto-pause if nobody answers within N seconds (0 = never)
SUPERVISED_TIMEOUT=90
# Autonomous mode action: pause | cancel
AUTONOMOUS_ACTION=pause
# "Ignore (False Alarm)" snoozes alerts for N seconds
SNOOZE_SECONDS=60
# Store ignored frames in ./false_positives/ for retraining (oldest deleted beyond max)
SAVE_FALSE_POSITIVES=true
MAX_FALSE_POSITIVES=50
# Testing only: run the AI even when the printer is not printing
FORCE_AI_WHEN_IDLE=false

# --- Klipper / Moonraker ----------------------------------------------------
MOONRAKER_URL=http://localhost:7125
# Only needed if Moonraker requires authentication for localhost
MOONRAKER_API_KEY=
# How often the printer state is polled while idle / for notifications
IDLE_POLL_INTERVAL=10
WATCH_INTERVAL=5

# --- Camera -----------------------------------------------------------------
# Crowsnest snapshot (ustreamer & camera-streamer both answer this URL;
# camera-streamer also offers http://127.0.0.1:8080/snapshot)
CAMERA_SNAPSHOT_URL=http://127.0.0.1:8080/?action=snapshot
SNAPSHOT_TIMEOUT=3
# Bigger snapshots are downscaled on decode to save RAM
SNAPSHOT_MAX_WIDTH=1024
# Rotate Crowsnest snapshots 180° (only if Crowsnest is NOT already flipping)
FLIP_SNAPSHOT_180=false
# Rotate raw Picamera2 fallback frames 180° (camera mounted upside-down)
FLIP_CAMERA_180=true
# Picamera2 fallback: manual macro focus in dioptres (10.0 ≈ 10 cm)
LENS_POSITION=10.0
PICAM_WIDTH=640
PICAM_HEIGHT=480
JPEG_QUALITY=85

# --- Notifications ----------------------------------------------------------
NOTIFY_STARTUP=true
NOTIFY_PRINT_COMPLETE=true
NOTIFY_PRINT_CANCELLED=true
NOTIFY_KLIPPER_ERRORS=true

# DEBUG prints every inference
LOG_LEVEL=INFO
